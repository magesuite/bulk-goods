<?xml version="1.0" ?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote">
        <column name="bulk_goods_fee" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee" default="0.0000" />
    </table>

    <table name="sales_order">
        <column name="bulk_goods_fee" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee" default="0.0000" />
        <column name="bulk_goods_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee tax" default="0.0000" />
        <column name="bulk_goods_fee_invoiced" xsi:type="decimal" scale="4" precision="12" nullable="false" comment="Bulk Goods Fee invoiced" default="0.0000" />
        <column name="bulk_goods_tax_invoiced" xsi:type="decimal" scale="4" precision="12" nullable="false" comment="Bulk Goods Fee tax invoiced" default="0.0000" />
    </table>

    <table name="sales_invoice">
        <column name="bulk_goods_fee" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee" default="0.0000" />
        <column name="bulk_goods_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee tax" default="0.0000" />
    </table>

    <table name="sales_creditmemo">
        <column name="bulk_goods_fee" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee" default="0.0000" />
        <column name="bulk_goods_tax" xsi:type="decimal" scale="4" precision="12" nullable="true" comment="Bulk Goods Fee tax" default="0.0000" />
    </table>
</schema>
